{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node tools/build-catalog.js --check && node tools/build-chrome.js --check && node tools/check-pages.js",
  "outputDirectory": ".",
  "trailingSlash": true,
  "functions": {
    "api/marketing-kit.mjs": {
      "memory": 3009,
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    }
  },
  "redirects": [
    {
      "source": "/api/(.*).js",
      "destination": "/api/$1",
      "permanent": false
    },
    {
      "source": "/pricing/",
      "destination": "/#websites",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/#websites",
      "permanent": true
    },
    {
      "source": "/pricing/:path*",
      "destination": "/#websites",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/niche-landing.html",
      "destination": "/#catalog",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sites/(.+)",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?systemsbyvega\\.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/assets/proof/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/__owner__/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
